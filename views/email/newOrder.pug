extends baseEmail

block content
  // HEADER - Título do Pedido
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%; margin-bottom: 40px; border-bottom: 2px solid #000; padding-bottom: 20px;')
    tbody
      tr
        td(style='width: 50%; text-align: left; vertical-align: middle;')
          p(style='margin: 0 0 8px 0; font-size: 13px; color: #666; text-transform: uppercase; letter-spacing: 1px;') Número do Pedido
          p(style='margin: 0 0 12px 0; font-size: 18px; color: #000; font-weight: 600;') ##{orderIdShort}
          p(style='margin: 0; font-size: 13px; color: #666;') #{orderDate}
       
  // INFORMAÇÕES DO CLIENTE
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%; margin-bottom: 40px;')
    tbody
      tr
        td(style='vertical-align: top;')
          p(style='margin: 0 0 10px 0; font-size: 12px; font-weight: bold; color: #000; text-transform: uppercase; letter-spacing: 1px;') CLIENTE:
          p(style='margin: 0 0 5px 0; font-size: 14px; color: #333;') #{customerName}
          p(style='margin: 0 0 5px 0; font-size: 14px; color: #666;') #{customerEmail}
          if customerPhone && customerPhone !== 'N/A'
            p(style='margin: 0; font-size: 14px; color: #666;') #{customerPhone}

  // TABELA DE PRODUTOS
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%; margin-bottom: 30px; border-collapse: collapse;')
    thead
      tr(style='border-bottom: 1px solid #ddd;')
        th(style='text-align: left; padding: 12px 0; font-size: 12px; font-weight: bold; color: #000; text-transform: uppercase; letter-spacing: 0.5px;') Item
        th(style='text-align: center; padding: 12px 0; font-size: 12px; font-weight: bold; color: #000; text-transform: uppercase; letter-spacing: 0.5px;') Quantidade
        th(style='text-align: right; padding: 12px 0; font-size: 12px; font-weight: bold; color: #000; text-transform: uppercase; letter-spacing: 0.5px;') Preço Unitário
        th(style='text-align: right; padding: 12px 0; font-size: 12px; font-weight: bold; color: #000; text-transform: uppercase; letter-spacing: 0.5px;') Total
    tbody
      each product in products
        tr(style='border-bottom: 1px solid #eee;')
          td(style='padding: 15px 0; font-size: 14px; color: #333;') #{product.name}
          td(style='text-align: center; padding: 15px 0; font-size: 14px; color: #333;') #{product.quantity}
          td(style='text-align: right; padding: 15px 0; font-size: 14px; color: #333;') #{product.unitPrice} MZN
          td(style='text-align: right; padding: 15px 0; font-size: 14px; color: #333;') #{product.total} MZN

  // RESUMO DE VALORES
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%; margin-left: auto; margin-bottom: 40px; max-width: 300px;')
    tbody
      tr
        td(style='text-align: right; padding: 8px 0; font-size: 14px; color: #666;') Subtotal:
        td(style='text-align: right; padding: 8px 0 8px 20px; font-size: 14px; color: #333; font-weight: 500;') #{subtotal} MZN
      if discount && parseFloat(discount) > 0
        tr
          td(style='text-align: right; padding: 8px 0; font-size: 14px; color: #666;') Desconto:
          td(style='text-align: right; padding: 8px 0 8px 20px; font-size: 14px; color: #dc3545; font-weight: 500;') -#{discount} MZN
      tr
        td(style='text-align: right; padding: 15px 0 8px 0; font-size: 16px; font-weight: bold; color: #000; border-top: 2px solid #000;') Total:
        td(style='text-align: right; padding: 15px 0 8px 20px; font-size: 20px; font-weight: bold; color: #000; border-top: 2px solid #000;') #{total} MZN

  // STATUS DO PEDIDO
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%; margin-bottom: 30px;')
    tbody
      tr
        td
          p(style='margin: 0; font-size: 14px; color: #666;')
            strong Status: 
            span(style='text-transform: capitalize; color: #333;') #{status}

  // OBSERVAÇÕES (se houver)
  if notes && notes.trim() !== ''
    table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%; margin-bottom: 40px; background-color: #f8f9fa; padding: 15px; border-radius: 4px;')
      tbody
        tr
          td
            p(style='margin: 0 0 8px 0; font-size: 12px; font-weight: bold; color: #666; text-transform: uppercase;') Observações:
            p(style='margin: 0; font-size: 14px; color: #333; line-height: 1.6;') #{notes}

  // INFORMAÇÕES DA EMPRESA E BOTÃO DE AÇÃO
  table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width: 100%;')
    tbody
      tr
        td(style='text-align: center;')
          // Botão de ação
          table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0', style='margin: 0 auto;')
            tbody
              tr
                td(align='center')
                  table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                    tbody
                      tr
                        td
                          a(href=`${frontendUrl}/admin`, target='_blank', style='background-color: #000; border: none; color: #ffffff; padding: 12px 30px; text-decoration: none; border-radius: 4px; display: inline-block; font-weight: 500; font-size: 14px;') Ver Detalhes do Pedido
